{
  "manifest_version": 3,
  "name": "Browser Control Core",
  "version": "0.3.0",
  "description": "Integrated control core for modes, privacy, resources, dark UI and ad blocking.",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "theme",
    "declarativeNetRequest",
    "management",
    "privacy"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Apri/chiudi impostazioni"
  },
  "sidebar_action": {
    "default_title": "Impostazioni Browser",
    "default_panel": "sidebar.html",
    "open_at_install": false
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_basic",
        "enabled": true,
        "path": "rules/ads-basic.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "resource-controller@matrixneo23.browser",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "https://html.duckduckgo.com/*",
    "<all_urls>"
  ]
}
